# StartupOps AI - Environment Configuration Template

# LLM & AI Configuration (Server-side only)
GOOGLE_AI_STUDIO_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Security & Encryption
APP_SECRET_KEY=super_secret_jwt_and_session_signing_key_32bytes_minimum!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///./startupops.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/startupops
REDIS_URL=redis://localhost:6379/0

# URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# OAuth Integrations (GitHub, Google, Slack)
GITHUB_CLIENT_ID=gh_mock_or_real_client_id
GITHUB_CLIENT_SECRET=gh_mock_or_real_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/integrations/github/callback

GOOGLE_CLIENT_ID=google_client_id_here
GOOGLE_CLIENT_SECRET=google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback

SLACK_CLIENT_ID=slack_client_id_here
SLACK_CLIENT_SECRET=slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/slack/callback
